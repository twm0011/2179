{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "title": {
    "text": "Malaysia Absolute Poverty Rate by State (2022)",
    "subtitle": "Percentage of households below the poverty line",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator",
    "scale": 1800,
    "center": [109.5, 3.5],
    "translate": [350, 250]
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#a8d0e6", "stroke": "#6baed6", "strokeWidth": 0.5}
    },
    {
      "data": {"graticule": {"step": [2, 2]}},
      "mark": {"type": "geoshape", "filled": false, "stroke": "#c0d8e8", "strokeWidth": 0.3}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/twm0011/2179/refs/heads/main/malaysia-states-merged.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "calculate": "datum.properties.Name === 'Penang' ? 'Pulau Pinang' : datum.properties.Name",
          "as": "stateName"
        },
        {
          "lookup": "stateName",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/bonkers69420/2179/refs/heads/main/hh_poverty_state.csv",
              "format": {"type": "csv"}
            },
            "key": "state",
            "fields": ["poverty_absolute", "date"]
          }
        },
        {"filter": "datum.date === '2022-01-01'"},
        {"calculate": "toNumber(datum.poverty_absolute)", "as": "poverty_rate"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "poverty_rate",
          "type": "quantitative",
          "title": "Poverty Rate (%)",
          "scale": {"scheme": "orangered", "domain": [0, 20]},
          "legend": {"titleFontSize": 12, "labelFontSize": 11, "format": ".1f"}
        },
        "tooltip": [
          {"field": "stateName", "type": "nominal", "title": "State"},
          {"field": "poverty_rate", "type": "quantitative", "title": "Poverty Rate (%)", "format": ".1f"}
        ]
      }
    }
  ]
}
