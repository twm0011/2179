{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "title": {
    "text": "Malaysia Absolute Poverty Rate by State (2022)",
    "subtitle": "Percentage of households below the poverty line",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator",
    "scale": 1800,
    "center": [109.5, 3.5],
    "translate": [350, 250]
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#a8d0e6"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/twm0011/2179/refs/heads/main/land-110m.json",
        "format": {"type": "topojson", "feature": "land"}
      },
      "mark": {"type": "geoshape", "fill": "#C2C79B", "stroke": "#b0a080", "strokeWidth": 1.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/twm0011/2179/refs/heads/main/ne_10m_graticules_5.geojson",
        "format": {"type": "json"}
      },
      "mark": {"type": "geoshape", "filled": false, "stroke": "#89b4c9", "strokeWidth": 1}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/twm0011/2179/refs/heads/main/my.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Labuan' && datum.properties.name !== 'Kuala Lumpur' && datum.properties.name !== 'Putrajaya'"
        },
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/twm0011/2179/refs/heads/main/poverty_2022.csv",
              "format": {"type": "csv"}
            },
            "key": "state",
            "fields": ["poverty_absolute"]
          }
        },
        {"calculate": "toNumber(datum.poverty_absolute)", "as": "poverty_rate"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
      "encoding": {
                    "color": {
            "field": "poverty_rate",
            "type": "quantitative",
            "title": "Poverty Rate (%)",
            "scale": {
                "type": "threshold",
                "domain": [7.5, 13.2],
                "range": ["#fdd49e", "#fc8d59", "#d7301f", "#7f0000"]
            },
            "legend": {
                "titleFontSize": 12,
                "labelFontSize": 11,
                "format": ".1f"
            }
            },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "State"},
          {"field": "poverty_rate", "type": "quantitative", "title": "Poverty Rate (%)", "format": ".1f"}
        ]
      }
    }
  ]
}
